# ============================================================
# REGLA MULTI-DOMINIO: Separar aura-adamo.site de l1deres.site
# Cuando el visitante entra desde aura-adamo.site,
# se sirven los archivos de la subcarpeta /aura-adamo/
# ============================================================
RewriteEngine On

RewriteCond %{HTTP_HOST} ^(www\.)?aura-adamo\.site$ [NC]
RewriteCond %{REQUEST_URI} !^/aura-adamo/
RewriteRule ^(.*)$ /aura-adamo/$1 [L]

# ============================================================
# Apache / LiteSpeed Web Server Configuration for DonWeb
# App: Aura v1.5 - Panel Administrativo (L1deres AutoWash)
# ============================================================

DirectoryIndex index.html
Options -Indexes

RewriteCond %{HTTP_HOST} !^(www\.)?aura-adamo\.site$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# --- CABECERAS DE SEGURIDAD ---
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- CACHÉ Y NO-CACHE EN TIEMPO REAL ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 0 seconds"
    ExpiresByType text/javascript "access plus 0 seconds"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|json|html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

# Bloquear acceso público directo a archivos de visitas y registros
<FilesMatch "\.(csv|txt)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

